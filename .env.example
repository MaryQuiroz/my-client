# =============================================================================
# MY CLIENT — Variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local ni ningún .env al repositorio.
# =============================================================================

# --- Supabase (Fase 1 y 2) ---
# Obtenlos en: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
# Solo en servidor (nunca en cliente)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# --- Google Places API (Fase 3) ---
# Habilita "Places API (New)" en Google Cloud Console
# https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=tu_google_places_api_key

# --- Google PageSpeed Insights API (Fase 4) ---
# La misma clave de Google Cloud sirve si tienes "PageSpeed Insights API" habilitada
GOOGLE_PAGESPEED_API_KEY=tu_google_pagespeed_api_key

# --- Anthropic (Fase 6) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=tu_anthropic_api_key

# --- Stripe (Fase 10) ---
# https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Genera el webhook secret con: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs de precio de Stripe para cada plan (Fase 10)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...

# --- Analítica — PostHog EU (Fase 12) ---
# https://eu.posthog.com/
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Proveedor de lugares (Fase 3) ---
# Valores posibles: google | osm | foursquare
PLACES_PROVIDER=google

# --- App (general) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En producción: https://my-client.vercel.app
